#include <bits/stdc++.h>
using namespace std;

void solve() {
    string a, b;
    cin >> a >> b;

    int n = a.size();
    int m = b.size();

    // Prefix sums modulo 10
    vector<int> pa(n + 1, 0), pb(m + 1, 0);

    for (int i = 0; i < n; i++)
        pa[i + 1] = (pa[i] + (a[i] - '0')) % 10;

    for (int i = 0; i < m; i++)
        pb[i + 1] = (pb[i] + (b[i] - '0')) % 10;

    // Total sums must be equal
    if (pa[n] != pb[m]) {
        cout << -1 << '\n';
        return;
    }

    // LCS of prefix sums
    vector<vector<short>> dp(n + 1, vector<short>(m + 1, 0));

    for (int i = 1; i <= n; i++) {
        for (int j = 1; j <= m; j++) {

            dp[i][j] = max(dp[i - 1][j], dp[i][j - 1]);

            if (pa[i] == pb[j]) {
                dp[i][j] = max(
                    dp[i][j],
                    (short)(dp[i - 1][j - 1] + 1)
                );
            }
        }
    }

    int ans = dp[n][m];

    cout << (ans == 0 ? -1 : ans) << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;

    while (t--)
        solve();

    return 0;
}