#include <bits/stdc++.h>
using namespace std;

int n, m;
vector<string> grid;
vector<vector<bool>> vis;
vector<vector<char>> parent;

int dx[] = {1, -1, 0, 0};
int dy[] = {0, 0, 1, -1};

char moveChar[] = {'D', 'U', 'R', 'L'};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    cin >> n >> m;

    grid.resize(n);

    pair<int, int> A, B;

    for (int i = 0; i < n; i++) {
        cin >> grid[i];

        for (int j = 0; j < m; j++) {
            if (grid[i][j] == 'A')
                A = {i, j};

            if (grid[i][j] == 'B')
                B = {i, j};
        }
    }

    vis.assign(n, vector<bool>(m, false));
    parent.assign(n, vector<char>(m, 0));

    queue<pair<int, int>> q;

    q.push(A);
    vis[A.first][A.second] = true;

    while (!q.empty()) {
        auto [x, y] = q.front();
        q.pop();

        for (int k = 0; k < 4; k++) {
            int nx = x + dx[k];
            int ny = y + dy[k];

            if (nx < 0 || nx >= n ||
                ny < 0 || ny >= m)
                continue;

            if (grid[nx][ny] == '#')
                continue;

            if (vis[nx][ny])
                continue;

            vis[nx][ny] = true;

            // Store the move used to reach this cell
            parent[nx][ny] = moveChar[k];

            q.push({nx, ny});
        }
    }

    if (!vis[B.first][B.second]) {
        cout << "NO\n";
        return 0;
    }

    // Reconstruct path from B back to A
    string path;

    int x = B.first;
    int y = B.second;

    while (x != A.first || y != A.second) {

        char c = parent[x][y];
        path.push_back(c);

        if (c == 'D')
            x--;       // came from above

        else if (c == 'U')
            x++;       // came from below

        else if (c == 'R')
            y--;       // came from left

        else if (c == 'L')
            y++;       // came from right
    }

    reverse(path.begin(), path.end());

    cout << "YES\n";
    cout << path.size() << '\n';
    cout << path << '\n';
}